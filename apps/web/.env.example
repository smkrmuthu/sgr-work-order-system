# Copy to .env.local (never commit the real file — it's git-ignored).
# Both values are safe to ship in the browser bundle: every table and function they can reach is
# protected by Row-Level Security (see db/migrations/002_rls.sql). Get them from your Supabase
# project: Project Settings -> API Keys -> "Publishable key" (NOT the secret/service_role key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
